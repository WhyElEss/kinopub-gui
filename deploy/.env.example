# Copy to deploy/.env on the server, fill it in, and `chmod 600 deploy/.env`.
# The real file is gitignored: it carries both secrets on this box.
#
#   cp .env.example .env && chmod 600 .env

# ── the login ───────────────────────────────────────────────────────────────
#
# Produce the hash with:
#
#   docker compose run --rm kinopub-gui -hash-password
#
# It prompts twice with echo off and prints the line to paste here. Nothing is
# saved by that command — it runs inside the container, where .env is not even
# mounted. Paste with an editor rather than a shell redirect, so the hash stays
# out of your shell history.
#
# Setting this turns the login on for EVERY request, the LAN included. Removing
# it turns the login off again — which is also why KINOPUB_PUBLIC_HOST must go
# with it: the server refuses to start with a public hostname and no password.
KINOPUB_AUTH_PASSWORD_HASH=

# The account name the login form must match. Optional; defaults to "admin".
# Still ONE account: a wrong name and a wrong password give the same answer, so
# it is a real check rather than a way to enumerate users.
#KINOPUB_AUTH_USER=admin

# The second factor normally lives in /config/totp.json, enrolled from
# Settings → Security once you are signed in — a button, not a file, because
# only someone already inside can add one. This variable is the headless
# alternative and WINS if set; the page then says so instead of offering a
# disable button it could not honour. A malformed value here is a startup
# error, same as a malformed password hash.
#KINOPUB_AUTH_TOTP_SECRET=

# ── the public endpoint ─────────────────────────────────────────────────────

# The single public hostname this server may be addressed by. Leave empty for a
# LAN-only install. With it set, the anti-DNS-rebinding guard lets that ONE name
# through — which is safe only because a session, not the Host header, is what
# grants access from then on.
KINOPUB_PUBLIC_HOST=kino.stanislavski.me

# Cloudflare Tunnel token, from the dashboard (Zero Trust → Networks → Tunnels).
# Kept here rather than on the cloudflared command line, where `ps` would show
# it to every user on the box.
TUNNEL_TOKEN=
